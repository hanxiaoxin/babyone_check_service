# Copy this file to .env, fill values, then run: go run .
# Existing process environment variables take precedence over .env.
API_TOKEN=hanxiaoxin
LISTEN_ADDR=127.0.0.1:8080
DB_PATH=monitor.db
CORS_ORIGIN=*

# Only initializes a NEW database. Afterwards use PATCH /api/v1/settings.
AUTO_NOTIFY=false

# SMTP: use starttls for port 587, tls for port 465. TLS is always verified.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
# SMTP authorization password (often an app password).
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated plain email addresses.
SMTP_TO=
